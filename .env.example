# ── Better Auth ──────────────────────────────────────────────────────────────
# Required. Minimum 32 characters. Generate one with:  openssl rand -base64 32
# If this changes (or is missing) every existing session cookie stops working.
BETTER_AUTH_SECRET=

# Public URL of the deployment. Local: http://localhost:3000
# Production: https://your-app.vercel.app  (no trailing slash)
# When unset in production the app derives it from VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Local: mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=

# Database name. Must be identical in every environment: accounts written under
# one name simply do not exist under another (logins then fail as "invalid
# email or password"). Better Auth creates user/session/account/verification
# collections on first use.
MONGODB_DB_NAME=tesserae

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave both empty to run without Google sign-in; the button then reports
# "Google sign-in is not configured on the server yet." instead of failing.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=